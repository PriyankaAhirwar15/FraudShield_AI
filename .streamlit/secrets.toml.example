# ─────────────────────────────────────────────────────────────────────────────
# FraudShield AI — Streamlit Cloud Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW TO USE:
#
# Option A — Streamlit Cloud (recommended):
#   1. Go to your app on share.streamlit.io
#   2. Click "⋮" → "Settings" → "Secrets"
#   3. Paste the key-value pairs below (without the comments).
#
# Option B — Local development:
#   1. Copy this file to: .streamlit/secrets.toml
#   2. Fill in the real values.
#   3. Never commit secrets.toml to git (it is in .gitignore).
#
# ─────────────────────────────────────────────────────────────────────────────

# URL of the deployed FastAPI backend (e.g. on Render)
# Replace with YOUR actual Render service URL.
# Example: https://fraudshield-ai.onrender.com
BACKEND_URL = "https://YOUR-RENDER-SERVICE-NAME.onrender.com"
